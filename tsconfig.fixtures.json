{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Angular's AtomFixture uses legacy (experimental) decorators, its own compiler's expected mode.
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["react", "react-dom"]
  },
  "include": ["test/fixtures/frameworks/**/*.tsx", "test/fixtures/frameworks/**/*.ts"]
}
